# Local development settings. Copy this file to .env and fill real values.
SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-werkzeug-security-generate-password-hash
APP_HOST=localhost
APP_PORT=5050
APP_DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Hash üretmek için örnek:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_SECONDS=600

# Production database (Render/Supabase)
DATABASE_URL=
